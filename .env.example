# Supabase project settings — find these in Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key — server-only, never exposed to the browser.
# Used for trusted admin operations that must bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Random 16+ character secret used to authenticate the scheduled-publishing job.
CRON_SECRET=replace-with-a-long-random-secret

# Optional server-side error webhook. Leave blank when no provider is configured.
MONITORING_WEBHOOK_URL=
